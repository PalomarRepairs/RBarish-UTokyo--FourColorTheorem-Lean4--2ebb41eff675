open ConfigSyntax

/-- math-comp `Birkhoff2`: there are no nontrivial rings of size 2 (basis: the single edge,
Coq `Cprog` with no step). -/
theorem birkhoff2 : BirkhoffCheck 1 0 :=
  .intro 1 2 [[]] tauNet2 cnvNet2 rvNet2 (tauSpec_of_check (by decide) (by decide +kernel))
    (cnvSpec_of_check (by decide) (by decide +kernel))
    (netSpec_reverse_of_check (by decide) (by decide +kernel)) (by decide +kernel) (by decide +kernel)

/-- math-comp `Birkhoff3`: there are no nontrivial rings of size 3. -/
theorem birkhoff3 : BirkhoffCheck 2 0 :=
  .intro 1 2 [Cprog Y] tauNet3 cnvNet3 rvNet3 (tauSpec_of_check (by decide) (by decide +kernel))
    (cnvSpec_of_check (by decide) (by decide +kernel))
    (netSpec_reverse_of_check (by decide) (by decide +kernel)) (by decide +kernel) (by decide +kernel)

/-- math-comp `Birkhoff4`: there are no nontrivial rings of size 4. -/
theorem birkhoff4 : BirkhoffCheck 3 0 :=
  .intro 4 2 [Cprog U, Cprog 1 U] tauNet4 cnvNet4 rvNet4 (tauSpec_of_check (by decide) (by decide +kernel))
    (cnvSpec_of_check (by decide) (by decide +kernel))
    (netSpec_reverse_of_check (by decide) (by decide +kernel)) (by decide +kernel) (by decide +kernel)

/-- math-comp `Birkhoff5`: the rings of size 5 have a single face on one of their sides. -/
theorem birkhoff5 : BirkhoffCheck 4 1 :=
  .intro 10 2 [Cprog U Y, Cprog 1 U Y, Cprog 2 U Y, Cprog 3 U Y, Cprog 4 U Y, Cprog H 4 Y Y Y]
    tauNet5 cnvNet5 rvNet5 (tauSpec_of_check (by decide) (by decide +kernel))
    (cnvSpec_of_check (by decide) (by decide +kernel))
    (netSpec_reverse_of_check (by decide) (by decide +kernel)) (by decide +kernel) (by decide +kernel)

