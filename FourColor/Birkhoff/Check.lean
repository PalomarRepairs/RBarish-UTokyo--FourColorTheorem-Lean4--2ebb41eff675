/-!
# The Birkhoff check (port of `birkhoff.v`, section `BirkhoffCheck` and module
`BirkhoffCheckLemmas`)

* `cpcard cp`          : the number of darts of `cpmap cp` (Coq `cpcard`, `card_cpmap`).
* `birkhoffCheck1 h m cp` : the basis program `cp` builds a cubic (not necessarily connected)
  configuration with ring size `h + 1` and fewer than `6 m + 4 h - 1` darts (Coq
  `Birkhoff_check1`).
* `BirkhoffCheck h m`  : all configurations with ring size `h + 1` and kernel size greater
  than `m` are locally reducible (reducible in a map with more than `m` other faces); a
  successful check excludes the rings of size `h + 1` with more than `m` faces on both sides
  from a minimal counter-example (`Hypermap.birkhoff_valid`, in `Birkhoff/Valid.lean`)
  (Coq `Birkhoff_check`).
* `birkhoff2` … `birkhoff5` : the checks for the rings of size `2` to `5` (Coq `Birkhoff2` …
  `Birkhoff5`), established by kernel computations (`decide +kernel`).

## The reformulated check

Coq's `Birkhoff_check h m` is the inductive proposition whose evidence is an iteration count
`niter` and a list `cps` of *basis* programs such that `all Birkhoff_check1 cps` and
`Birkhoff_check2 … niter …` hold, where `Birkhoff_check2` plays a game on pairs of
`ctree`/`gtree`s with `Kempe_tree_closure`, starting from the full trees `ctree_init_tree h`,
`gtree_init_tree h`, and picking the traces with `ctree_pick_rev`.

The `ctree`/`gtree` machinery (`ctree.v`, `gtree.v`, `kempetree.v`, …) is not ported (see
`Engine/Birkhoff.lean`): the same game is played by the reducibility engine on sound trace sets in
its packed layout (`Engine.bk2`, `Engine.birkhoffCheck`, whose soundness is
`Engine.bk2_false`).  Accordingly, the evidence of `BirkhoffCheck h m` is

* the iteration count `niter` and the basis programs `cps` (as in Coq), with
  `cps.all (birkhoffCheck1 h m)`;
* the number `fuel` of engine rounds used to close each new trace set (Coq closes the
  `ctree`s completely with `Kempe_tree_closure`; `fuel = 2` suffices for the four checks);
* three delta-swap networks for the ring size `h + 1`, given with their specifications: the
  color transposition `Color1 ↔ Color2` (`TauSpec`), the conversion of the base-3 layout of
  the coloring DP into the packed layout (`CnvSpec`), and the ring reversal `t ↦ rev t`
  (`NetSpec … List.reverse`), which relates the traces of the two sides of a ring
  (Coq pairs `e :: et` with `rev (e :: et)` in `Birkhoff_check2`);
* the success of the game: `Engine.birkhoffCheck (h + 1) tau rv basis fuel niter = true`,
  where the basis coloring sets `basis = cps.map (dpP1 (h + 1) cnv)` are the ring traces of
  the basis maps (computed by the engine's coloring DP), in the orientation of `cpring` (in the
  proof of `birkhoff_valid` the border of the basis map is `rev (cpring Gr)`, for which the
  ring traces given by `colorable_patch` are exactly the ring traces of `cpring Gr`).

In each of `birkhoff2` … `birkhoff5` the networks are small literals generated by
`scripts/engine_nets.py r DIR` and `scripts/engine_nets.py --rev r DIR` (they are *checked*
by the kernel: `tauCheck`, `cnvCheck`, `xformCheck`), the basis programs and the iteration
counts are Coq's, and `fuel = 2`.  Not ported: `ctree_pick_rev_rec`, `ctree_pick_rev`,
`sumt_ctree_pick_rev`, `size_ctree_pick_rev`, `do_Birkhoff_check2`, `Birkhoff_check2`
(replaced by `Engine.bk2`).
-/

namespace FourColor

open Engine

/-! ### Dart counts of configuration maps -/

/-- math-comp `cpcard cp`: the number of darts in `cpmap cp`. -/
def cpcard : Cprog → ℕ
  | [] => 2
  | .R _ :: cp => cpcard cp
  | .A :: cp => cpcard cp
  | .R' :: cp => cpcard cp
  | .U :: cp => cpcard cp + 2
  | .K :: cp => cpcard cp + 2
  | .Y :: cp => cpcard cp + 4
  | .H :: cp => cpcard cp + 4 + 2

/-- math-comp `card_cpmap`. -/
theorem card_cpmap (cp : Cprog) : Fintype.card (cpmap cp).D = cpcard cp := by
  induction cp with
  | nil => exact Fintype.card_bool
  | cons s cp ih =>
    cases s with
    | R n => exact ih
    | R' => exact ih
    | A => exact ih
    | U =>
      show Fintype.card (EcpDart (cpmap cp).D) = cpcard cp + 2
      rw [EcpDart.card_ecp, ih]
    | K =>
      show Fintype.card (EcpDart (cpmap cp).D) = cpcard cp + 2
      rw [EcpDart.card_ecp, ih]
    | Y =>
      show Fintype.card (EcpDart (EcpDart (cpmap cp).D)) = cpcard cp + 4
      rw [EcpDart.card_ecp, EcpDart.card_ecp, ih]
    | H =>
      show Fintype.card (EcpDart (EcpDart (EcpDart (cpmap cp).D))) = cpcard cp + 4 + 2
      rw [EcpDart.card_ecp, EcpDart.card_ecp, EcpDart.card_ecp, ih]

/-! ### The Birkhoff check -/

/-- math-comp `Birkhoff_check1 cp` (section variables `h m`): `cp` builds a cubic (but not
necessarily connected) configuration, with fewer than `6 m + 4 h - 1` darts, and with ring size
`h + 1`. -/
def birkhoffCheck1 (h m : ℕ) (cp : Cprog) : Bool :=
  cubicProg cp && (decide (cpcard cp + 1 < 6 * m + 4 * h) && cprsize cp == h + 1)

/-- math-comp `Birkhoff_check h m`, reformulated on the reducibility engine (see the module
documentation): there are basis programs `cps` satisfying `birkhoffCheck1 h m`, networks for
the ring size `h + 1` realising `Color1 ↔ Color2` (`tau`), the conversion of the coloring DP
(`cnv`) and the ring reversal (`rv`), a number of closure rounds `fuel` and an iteration count
`niter` such that the Birkhoff game (`Engine.birkhoffCheck`), played with the coloring sets of
the basis programs, succeeds. -/
inductive BirkhoffCheck (h m : ℕ) : Prop
  /-- math-comp constructor `BirkhoffCheck niter cps`. -/
  | intro (niter fuel : ℕ) (cps : List Cprog) (tau cnv rv : Net)
      (htau : TauSpec (h + 1) tau) (hcnv : CnvSpec (h + 1) cnv)
      (hrv : NetSpec (h + 1) rv List.reverse)
      (hcps : cps.all (birkhoffCheck1 h m) = true)
      (hbk : birkhoffCheck (h + 1) tau rv (cps.map (dpP1 (h + 1) cnv)) fuel niter = true)

/-! ### The ring reversal network -/

/-- The ring reversal is the transform of the positions `p ↦ r - 1 - p` (on traces of
length `r`). -/
theorem xform_reverse {r : ℕ} {t : Colseq} (ht : t.length = r) :
    xform r (fun p => r - 1 - p) Eperm123 t = t.reverse := by
  apply List.ext_getElem
  · simp [xform, ht]
  · intro i h1 h2
    simp only [xform, List.getElem_map, List.getElem_range, List.getElem_reverse]
    simp only [xform, List.length_map, List.length_range] at h1
    rw [List.getD_eq_getElem _ _ (by omega)]
    simp only [permc]
    congr 1
    omega

/-- A network checked by `xformCheck` against the transform `p ↦ r - 1 - p` realises the ring
reversal. -/
theorem netSpec_reverse_of_check {r : ℕ} {rv : Net} (hr : 1 ≤ r)
    (h : xformCheck r rv (fun p => r - 1 - p) Eperm123 = true) : NetSpec r rv List.reverse := by
  have hs := netSpec_of_xformCheck (σ := fun p => r - 1 - p) hr (fun p _ => by omega)
    (fun p _ q _ e => by omega) h
  intro t ht x
  rw [hs t ht x, xform_reverse ht.1]

/-- `sumt` of a reversed trace. -/
theorem sumt_reverse (t : Colseq) : sumt t.reverse = sumt t := by
  induction t with
  | nil => rfl
  | cons c t ih => rw [List.reverse_cons, sumt_append, ih, sumt_cons, sumt_cons, sumt_nil,
      addc0, addcC]

/-- The reversal of a valid trace is valid. -/
theorem validTrace_reverse {r : ℕ} {t : Colseq} (ht : ValidTrace r t) :
    ValidTrace r t.reverse :=
  ⟨by rw [List.length_reverse, ht.1], by rw [List.mem_reverse]; exact ht.2.1,
    by rw [sumt_reverse, ht.2.2]⟩

