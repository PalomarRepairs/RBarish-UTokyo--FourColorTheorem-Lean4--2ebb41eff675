import FourColor.Engine.Chunk
import FourColor.Engine.Check

/-!
# Reducibility engine: the kernel checks on the chunked layout

The permutation closure `permCloseK` and the coloring DP `dpP1` apply the networks `τ12` and
`cnv` to the concatenated layout (`catG`, `2^21` bits at ring size 14).  Palomar's checker
nanoda is slow on the big right shifts this involves: those of the network layers and those of
`splitG`.  This file computes the same
functions on the concatenated layout cut into chunks of `2 ^ s` bits (`Chunk.lean`, `s = 16` in
the generated certificates):

* `catGC r s K`: the chunks of `catG r K`, built from the grades directly: each grade (masked to
  its size) is shifted left to its offset inside its first chunk and cut into chunks by
  *balanced halving* (`toChunksAux`), so that its right shifts cost about `gsize² / 2` bit
  operations in nanoda instead of `gtotal²`; the chunks are then or-ed in place (`orAt`);
* `splitGC r s cs`: the grades of the chunked layout: each grade is the chunk containing its
  first bit, shifted right by less than `2 ^ s` bits, or-ed with the following chunks shifted
  left (`extractC`);
* `permCloseKC`, `roundC`, `roundsNC`, `checkStepC`: `permCloseK`, `round`, `roundsN`,
  `checkStep` with the network applied chunk-wise (`applyNetC`);
* `dpP1C`, `checkInitC`, `checkFinalC`: `dpP1`, `checkInit`, `checkFinal` with the conversion
  network applied chunk-wise (the base-3 layout produced by the DP is cut into chunks by
  balanced halving).

Each is proved equal to its original, with the network assembled from its chunks
(`netOfChunks`), when the chunked network passes `netCOK` (`checkStep_eq_checkStepC`,
`checkInit_eq_checkInitC`, `checkFinal_eq_checkFinalC`).  The certificates generated by
`#engine_certify` state the original checks and prove them by kernel evaluation of the chunked
ones through these equalities.
-/

namespace FourColor.Engine

open FourColor

/-! ### Bits helpers -/

private theorem testBit_and_ones (x n i : Nat) :
    (x &&& ones n).testBit i = (x.testBit i && decide (i < n)) := by
  rw [Nat.testBit_and, testBit_ones]

private theorem and_ones_of_lt {x n : Nat} (h : x < 2 ^ n) : x &&& ones n = x := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [testBit_and_ones]
  by_cases hi : i < n
  · simp [hi]
  · rw [Nat.testBit_eq_false_of_lt (Nat.lt_of_lt_of_le h (Nat.pow_le_pow_right (by norm_num)
      (Nat.le_of_not_lt hi)))]
    simp

private theorem xor_shiftRight_shiftLeft (y k : Nat) : y ^^^ ((y >>> k) <<< k) = y &&& ones k := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_xor, Nat.testBit_shiftLeft, Nat.testBit_shiftRight, testBit_and_ones]
  by_cases hi : i < k
  · simp [hi, show ¬ i ≥ k by omega]
  · have e : k + (i - k) = i := by omega
    simp [hi, show i ≥ k by omega, e]

/-! ### Grades to chunks -/

/-- Balanced halving: the `n` chunks of `2 ^ s` bits of `y` (the last one not truncated),
followed by `acc`, for `1 ≤ n ≤ f + 1`: the lower `⌊n/2⌋` chunks and the upper ones are
split recursively (`ofChunks_toChunksAux`). -/
noncomputable def toChunksAux (s : Nat) (f : Nat) : Nat → Nat → List Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → List Nat → List Nat)
    (fun _ y acc => y :: acc)
    (fun _ ih n y acc =>
      @Bool.rec (fun _ => List Nat)
        (let k := n / 2 * 2 ^ s
         let hi := Nat.shiftRight y k
         ih (n / 2) (Nat.xor y (Nat.shiftLeft hi k)) (ih (n - n / 2) hi acc))
        (y :: acc) (Nat.ble n 1)) f

theorem toChunksAux_zero (s n y : Nat) (acc : List Nat) : toChunksAux s 0 n y acc = y :: acc :=
  rfl

theorem toChunksAux_succ (s f n y : Nat) (acc : List Nat) :
    toChunksAux s (f + 1) n y acc =
      bif Nat.ble n 1 then y :: acc else
        toChunksAux s f (n / 2) (y ^^^ ((y >>> (n / 2 * 2 ^ s)) <<< (n / 2 * 2 ^ s)))
          (toChunksAux s f (n - n / 2) (y >>> (n / 2 * 2 ^ s)) acc) := by
  show @Bool.rec (fun _ => List Nat) _ _ (Nat.ble n 1) = _
  cases Nat.ble n 1 <;> rfl

/-- The chunks of the balanced halving. -/
theorem ofChunks_toChunksAux (s : Nat) :
    ∀ (f n y : Nat) (acc : List Nat), 1 ≤ n → n ≤ f + 1 →
      ofChunks s (toChunksAux s f n y acc) =
        (y &&& ones (n * 2 ^ s)) ||| (ofChunks s acc <<< (n * 2 ^ s)) := by
  intro f
  induction f with
  | zero =>
    intro n y acc h1 h2
    have hn : n = 1 := by omega
    subst hn
    rw [toChunksAux_zero, ofChunks_cons, Nat.one_mul]
  | succ f ih =>
    intro n y acc h1 h2
    rw [toChunksAux_succ]
    by_cases hn : n ≤ 1
    · have hn1 : n = 1 := by omega
      subst hn1
      rw [show Nat.ble 1 1 = true from rfl, Bool.cond_true, ofChunks_cons, Nat.one_mul]
    · rw [show Nat.ble n 1 = false from
        Bool.eq_false_iff.2 (fun h => hn (Nat.le_of_ble_eq_true h)), Bool.cond_false]
      have hh1 : 1 ≤ n / 2 := by omega
      have hh2 : n / 2 ≤ f + 1 := by omega
      have hh3 : 1 ≤ n - n / 2 := by omega
      have hh4 : n - n / 2 ≤ f + 1 := by omega
      rw [ih _ _ _ hh1 hh2, ih _ _ _ hh3 hh4, xor_shiftRight_shiftLeft]
      have hsplit : n * 2 ^ s = n / 2 * 2 ^ s + (n - n / 2) * 2 ^ s := by
        rw [← Nat.add_mul]; congr 1; omega
      generalize n / 2 * 2 ^ s = a at hsplit ⊢
      generalize (n - n / 2) * 2 ^ s = b at hsplit ⊢
      rw [hsplit]
      apply Nat.eq_of_testBit_eq
      intro i
      simp only [Nat.testBit_or, Nat.testBit_shiftLeft, Nat.testBit_shiftRight, testBit_and_ones]
      by_cases hia : i < a
      · simp [hia, show ¬ i ≥ a by omega, show i < a + b by omega, show ¬ i ≥ a + b by omega]
      · have e1 : a + (i - a) = i := by omega
        by_cases hib : i < a + b
        · simp [hia, show i ≥ a by omega, e1, hib, show i - a < b by omega,
            show ¬ i ≥ a + b by omega, show ¬ i - a ≥ b by omega]
        · simp [hia, show i ≥ a by omega, hib, show ¬ i - a < b by omega,
            show i - a ≥ b by omega, show i ≥ a + b by omega,
            show i - a - b = i - (a + b) by omega]

/-- `orAt i acc ys`: `acc` with the chunks `ys` or-ed in from chunk `i` on (`acc` is padded with
zeros). -/
noncomputable def orAt (i : Nat) : List Nat → List Nat → List Nat :=
  Nat.rec (motive := fun _ => List Nat → List Nat → List Nat) (fun acc ys => orC acc ys)
    (fun _ ih acc ys => List.rec (motive := fun _ => List Nat) (0 :: ih [] ys)
      (fun a acc' _ => a :: ih acc' ys) acc) i

theorem orAt_zero (acc ys : List Nat) : orAt 0 acc ys = orC acc ys := rfl
theorem orAt_succ_nil (i : Nat) (ys : List Nat) : orAt (i + 1) [] ys = 0 :: orAt i [] ys := rfl
theorem orAt_succ_cons (i a : Nat) (acc ys : List Nat) :
    orAt (i + 1) (a :: acc) ys = a :: orAt i acc ys := rfl

theorem getD_orAt (i : Nat) (acc ys : List Nat) (c : Nat) :
    (orAt i acc ys).getD c 0 = acc.getD c 0 ||| (if i ≤ c then ys.getD (c - i) 0 else 0) := by
  induction i generalizing acc c with
  | zero => rw [orAt_zero, getD_orC, ite_eq_left (Nat.zero_le c), Nat.sub_zero]
  | succ i ih =>
    cases acc with
    | nil =>
      rw [orAt_succ_nil]
      cases c with
      | zero => simp
      | succ c =>
        rw [List.getD_cons_succ, ih]
        simp [show (i + 1 ≤ c + 1) = (i ≤ c) from propext (by omega),
          show c + 1 - (i + 1) = c - i by omega]
    | cons a acc =>
      rw [orAt_succ_cons]
      cases c with
      | zero => simp
      | succ c =>
        rw [List.getD_cons_succ, ih, List.getD_cons_succ]
        simp [show (i + 1 ≤ c + 1) = (i ≤ c) from propext (by omega),
          show c + 1 - (i + 1) = c - i by omega]

theorem ofChunks_orAt (s i : Nat) (acc ys : List Nat) :
    ofChunks s (orAt i acc ys) = ofChunks s acc ||| (ofChunks s ys <<< (i * 2 ^ s)) := by
  apply Nat.eq_of_testBit_eq
  intro p
  obtain ⟨c, j, hj, rfl⟩ := exists_chunk_pos s p
  rw [testBit_ofChunks_mul_add s _ c hj, getD_orAt, Nat.testBit_or, Nat.testBit_or,
    testBit_ofChunks_mul_add s acc c hj, Nat.testBit_shiftLeft]
  congr 1
  by_cases hic : i ≤ c
  · have e : 2 ^ s * c + j - i * 2 ^ s = 2 ^ s * (c - i) + j := by
      have : 2 ^ s * c = 2 ^ s * (c - i) + i * 2 ^ s := by
        rw [Nat.mul_comm i, ← Nat.mul_add]; congr 1; omega
      omega
    have hle : 2 ^ s * c + j ≥ i * 2 ^ s := by
      have := Nat.mul_le_mul_right (2 ^ s) hic
      rw [Nat.mul_comm c] at this; omega
    rw [ite_eq_left hic, e, testBit_ofChunks_mul_add s ys (c - i) hj]
    simp [hle]
  · have hlt : ¬ 2 ^ s * c + j ≥ i * 2 ^ s := by
      intro h
      have : 2 ^ s * c + j < 2 ^ s * (c + 1) := by rw [Nat.mul_add_one]; omega
      have := Nat.lt_of_le_of_lt h this
      rw [Nat.mul_comm i] at this
      have := Nat.lt_of_mul_lt_mul_left this
      omega
    rw [ite_eq_right hic]
    simp [hlt]

/-- The chunks of the concatenation of the grades `K`, starting with grade `k` at bit offset
`off`, or-ed into `acc`. -/
noncomputable def catGCAux (r s : Nat) (K : List Nat) : Nat → Nat → List Nat → List Nat :=
  List.rec (motive := fun _ => Nat → Nat → List Nat → List Nat) (fun _ _ acc => acc)
    (fun q _ ih k off acc =>
      let g := gsize r k
      let b := off % 2 ^ s
      ih (k + 1) (off + g)
        (orAt (off / 2 ^ s) acc
          (toChunksAux s ((b + g) / 2 ^ s + 1) ((b + g) / 2 ^ s + 1)
            (Nat.shiftLeft (Nat.land q (ones g)) b) []))) K

theorem catGCAux_nil (r s k off : Nat) (acc : List Nat) : catGCAux r s [] k off acc = acc := rfl

theorem catGCAux_cons (r s q : Nat) (K : List Nat) (k off : Nat) (acc : List Nat) :
    catGCAux r s (q :: K) k off acc =
      catGCAux r s K (k + 1) (off + gsize r k)
        (orAt (off / 2 ^ s) acc
          (toChunksAux s ((off % 2 ^ s + gsize r k) / 2 ^ s + 1)
            ((off % 2 ^ s + gsize r k) / 2 ^ s + 1)
            ((q &&& ones (gsize r k)) <<< (off % 2 ^ s)) [])) := rfl

/-- The chunks of `catG` (`ofChunks_catGC`). -/
noncomputable def catGC (r s : Nat) (K : List Nat) : List Nat := catGCAux r s K 0 0 []

theorem ofChunks_catGCAux (r s : Nat) (K : List Nat) :
    ∀ (k off : Nat) (acc : List Nat),
      ofChunks s (catGCAux r s K k off acc) = ofChunks s acc ||| catGAux r k off K := by
  induction K with
  | nil => intro k off acc; simp [catGCAux_nil, catGAux]
  | cons q K ih =>
    intro k off acc
    rw [catGCAux_cons, ih, ofChunks_orAt]
    have hW : 0 < 2 ^ s := Nat.two_pow_pos s
    have hn : off % 2 ^ s + gsize r k < ((off % 2 ^ s + gsize r k) / 2 ^ s + 1) * 2 ^ s := by
      rw [Nat.add_mul, Nat.one_mul]; exact Nat.lt_div_mul_add hW
    rw [ofChunks_toChunksAux s ((off % 2 ^ s + gsize r k) / 2 ^ s + 1)
      ((off % 2 ^ s + gsize r k) / 2 ^ s + 1) _ [] (Nat.le_add_left 1 _) (Nat.le_succ _),
      ofChunks_nil,
      Nat.zero_shiftLeft, Nat.or_zero]
    generalize (off % 2 ^ s + gsize r k) / 2 ^ s + 1 = n at hn ⊢
    have hy : (q &&& ones (gsize r k)) <<< (off % 2 ^ s) < 2 ^ (n * 2 ^ s) := by
      rw [Nat.shiftLeft_eq]
      have h1 : q &&& ones (gsize r k) < 2 ^ gsize r k := by
        apply Nat.lt_pow_two_of_testBit
        intro i hi
        rw [testBit_and_ones]; simp; omega
      calc (q &&& ones (gsize r k)) * 2 ^ (off % 2 ^ s)
          < 2 ^ gsize r k * 2 ^ (off % 2 ^ s) :=
            Nat.mul_lt_mul_of_pos_right h1 (Nat.two_pow_pos _)
        _ = 2 ^ (gsize r k + off % 2 ^ s) := by rw [Nat.pow_add]
        _ ≤ 2 ^ (n * 2 ^ s) := Nat.pow_le_pow_right (by norm_num) (by omega)
    rw [and_ones_of_lt hy, ← Nat.shiftLeft_add,
      show off % 2 ^ s + off / 2 ^ s * 2 ^ s = off by
        rw [Nat.mul_comm]; exact Nat.mod_add_div off (2 ^ s)]
    simp only [catGAux, Nat.or_assoc]

/-- **The chunks of `catGC` are those of `catG`.** -/
theorem ofChunks_catGC (r s : Nat) (K : List Nat) : ofChunks s (catGC r s K) = catG r K := by
  rw [catGC, ofChunks_catGCAux, ofChunks_nil, Nat.zero_or]
  rfl

/-! ### Chunks to grades -/

/-- `ofTake s cs n`: the number made of the first `n` chunks of `cs`. -/
noncomputable def ofTake (s : Nat) (cs : List Nat) : Nat → Nat :=
  List.rec (motive := fun _ => Nat → Nat) (fun _ => 0)
    (fun c _ ih n => Nat.rec (motive := fun _ => Nat) 0
      (fun n' _ => Nat.lor (Nat.land c (ones (2 ^ s))) (Nat.shiftLeft (ih n') (2 ^ s))) n) cs

theorem ofTake_eq (s : Nat) (cs : List Nat) (n : Nat) :
    ofTake s cs n = ofChunks s cs &&& ones (n * 2 ^ s) := by
  induction cs generalizing n with
  | nil => simp [ofTake]
  | cons c cs ih =>
    cases n with
    | zero => simp [ofTake, ones]
    | succ n =>
      show (c &&& ones (2 ^ s)) ||| (ofTake s cs n <<< 2 ^ s) = _
      rw [ih, ofChunks_cons]
      apply Nat.eq_of_testBit_eq
      intro i
      simp only [Nat.testBit_or, Nat.testBit_shiftLeft, testBit_and_ones]
      by_cases hi : i < 2 ^ s
      · simp [hi, show i < (n + 1) * 2 ^ s by rw [Nat.add_mul]; omega,
          show ¬ i ≥ 2 ^ s by omega]
      · have e : (i - 2 ^ s < n * 2 ^ s) = (i < (n + 1) * 2 ^ s) := by
          apply propext; rw [Nat.add_mul]; omega
        simp [hi, show i ≥ 2 ^ s by omega, e]

/-- The bits of the chunks from chunk `n` on. -/
theorem testBit_ofChunks_dropC (s n : Nat) (cs : List Nat) (i : Nat) :
    (ofChunks s (dropC n cs)).testBit i = (ofChunks s cs).testBit (n * 2 ^ s + i) := by
  have hW : 0 < 2 ^ s := Nat.two_pow_pos s
  rw [testBit_ofChunks, testBit_ofChunks, getD_dropC,
    show n * 2 ^ s + i = i + 2 ^ s * n by rw [Nat.mul_comm]; omega,
    Nat.add_mul_div_left _ _ hW, Nat.add_mul_mod_self_left, Nat.add_comm (i / 2 ^ s)]

/-- `extractC s cs o g`: the `g` bits of the chunked number `cs` from bit `o` on: the chunk
containing bit `o` shifted right by `o % 2^s`, or-ed with the following chunks shifted left. -/
noncomputable def extractC (s : Nat) (cs : List Nat) (o g : Nat) : Nat :=
  List.rec (motive := fun _ => Nat) 0
    (fun c rest _ => Nat.land (Nat.lor (Nat.shiftRight (Nat.land c (ones (2 ^ s))) (o % 2 ^ s))
      (Nat.shiftLeft (ofTake s rest ((o % 2 ^ s + g) / 2 ^ s)) (2 ^ s - o % 2 ^ s))) (ones g))
    (dropC (o / 2 ^ s) cs)

theorem extractC_eq (s : Nat) (cs : List Nat) (o g : Nat) :
    extractC s cs o g = (ofChunks s cs >>> o) &&& ones g := by
  have hW : 0 < 2 ^ s := Nat.two_pow_pos s
  have ho : o = o / 2 ^ s * 2 ^ s + o % 2 ^ s := by
    rw [Nat.mul_comm]; exact (Nat.div_add_mod o (2 ^ s)).symm
  have hb : o % 2 ^ s < 2 ^ s := Nat.mod_lt _ hW
  have key : ∀ j, (ofChunks s cs).testBit (o + j) =
      (ofChunks s (dropC (o / 2 ^ s) cs)).testBit (o % 2 ^ s + j) := by
    intro j
    rw [testBit_ofChunks_dropC]
    congr 1; omega
  unfold extractC
  generalize hd : dropC (o / 2 ^ s) cs = L at key
  generalize o % 2 ^ s = b at key hb ⊢
  apply Nat.eq_of_testBit_eq
  intro j
  rw [testBit_and_ones, Nat.testBit_shiftRight, key]
  cases L with
  | nil => simp
  | cons c rest =>
    show (Nat.land (Nat.lor (Nat.shiftRight (Nat.land c (ones (2 ^ s))) b)
      (Nat.shiftLeft (ofTake s rest ((b + g) / 2 ^ s)) (2 ^ s - b))) (ones g)).testBit j = _
    change (((c &&& ones (2 ^ s)) >>> b ||| (ofTake s rest ((b + g) / 2 ^ s) <<< (2 ^ s - b))) &&&
      ones g).testBit j = _
    rw [ofTake_eq, ofChunks_cons]
    simp only [testBit_and_ones, Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]
    by_cases hjg : j < g
    · simp only [hjg, decide_true, Bool.and_true]
      by_cases hbj : b + j < 2 ^ s
      · simp [hbj, show ¬ j ≥ 2 ^ s - b by omega, show ¬ b + j ≥ 2 ^ s by omega]
      · have hlt : b + j - 2 ^ s < (b + g) / 2 ^ s * 2 ^ s := by
          have := Nat.lt_div_mul_add (a := b + g) hW
          have h2 : (b + g) / 2 ^ s * 2 ^ s = b + g - (b + g) % 2 ^ s :=
            by rw [Nat.mul_comm]; have := Nat.div_add_mod (b + g) (2 ^ s); omega
          have h3 := Nat.mod_lt (b + g) hW
          omega
        simp [hbj, show j ≥ 2 ^ s - b by omega, show b + j ≥ 2 ^ s by omega, hlt,
          show j - (2 ^ s - b) = b + j - 2 ^ s by omega]
    · simp [hjg]

/-- The grades `k, k+1, …` (`n` of them) of a chunked layout, the grade `k` starting at bit
`o`. -/
noncomputable def splitGCAux (r s : Nat) (cs : List Nat) (n : Nat) : Nat → Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → List Nat) (fun _ _ => [])
    (fun _ ih k o => extractC s cs o (gsize r k) :: ih (k + 1) (o + gsize r k)) n

/-- The grades of a chunked layout (`splitGC_eq`). -/
noncomputable def splitGC (r s : Nat) (cs : List Nat) : List Nat :=
  splitGCAux r s cs (ngrades r) 0 0

theorem splitGCAux_eq (r s : Nat) (cs : List Nat) (n : Nat) :
    ∀ k o, splitGCAux r s cs n k o = splitGAux r n k (ofChunks s cs >>> o) := by
  induction n with
  | zero => intro k o; rfl
  | succ n ih =>
    intro k o
    show extractC s cs o (gsize r k) :: splitGCAux r s cs n (k + 1) (o + gsize r k) = _
    rw [ih, extractC_eq, Nat.shiftRight_add]
    rfl

/-- **The grades of a chunked layout are those of the number it represents.** -/
theorem splitGC_eq (r s : Nat) (cs : List Nat) : splitGC r s cs = splitG r (ofChunks s cs) := by
  rw [splitGC, splitGCAux_eq, Nat.shiftRight_zero]
  rfl

/-! ### The permutation closure and the rounds -/

/-- `permCloseK` with the network applied chunk-wise (`permCloseK_eq_permCloseKC`). -/
noncomputable def permCloseKC (r s : Nat) (net : NetC) (K : List Nat) : List Nat :=
  let xc := catGC r s K
  let ac := applyNetC s net xc
  let a23c := catGC r s (tau23 r (splitGC r s ac))
  let bc := applyNetC s net (orC xc a23c)
  splitGC r s (orC xc bc)

/-- `round` with the network applied chunk-wise. -/
noncomputable def roundC (r s : Nat) (net : NetC) (X : List Nat) : List Nat :=
  permCloseKC r s net (kempeStep r X)

/-- `roundsN` with the network applied chunk-wise. -/
noncomputable def roundsNC (r s : Nat) (net : NetC) : Nat → List Nat → List Nat
  | 0, X => X
  | n + 1, X => roundsNC r s net n (roundC r s net X)

/-- `checkStep` with the network applied chunk-wise (`checkStep_eq_checkStepC`). -/
noncomputable def checkStepC (r s : Nat) (net : NetC) (n : Nat) (H H' : List Nat) : Bool :=
  roundsNC r s net n (expand r H) == expand r H'

theorem permCloseK_eq_permCloseKC {r s : Nat} {net : NetC} (h : netCOK s net = true)
    (K : List Nat) : permCloseK r (netOfChunks s net) K = permCloseKC r s net K := by
  simp only [permCloseKC, permCloseK, splitGC_eq, ofChunks_orC, ofChunks_applyNetC h,
    ofChunks_catGC]

theorem round_eq_roundC {r s : Nat} {net : NetC} (h : netCOK s net = true) (X : List Nat) :
    round r (netOfChunks s net) X = roundC r s net X :=
  permCloseK_eq_permCloseKC h _

theorem roundsN_eq_roundsNC {r s : Nat} {net : NetC} (h : netCOK s net = true) (n : Nat)
    (X : List Nat) : roundsN r (netOfChunks s net) n X = roundsNC r s net n X := by
  induction n generalizing X with
  | zero => rfl
  | succ n ih => rw [roundsN, roundsNC, round_eq_roundC h, ih]

/-- **The chunked checkpoint step is the checkpoint step**, with the network assembled from its
chunks. -/
theorem checkStep_eq_checkStepC {s : Nat} {net : NetC} (h : netCOK s net = true)
    (r n : Nat) (H H' : List Nat) :
    checkStep r (netOfChunks s net) n H H' = checkStepC r s net n H H' := by
  rw [checkStep, checkStepC, roundsN_eq_roundsNC h]

/-! ### The coloring DP with the chunked conversion network -/

private theorem fold3_lt (r x : Nat) : fold3 r x < 2 ^ (3 ^ (r - 1)) := by
  apply Nat.lt_pow_two_of_testBit
  intro i hi
  simp only [fold3, Nat.testBit_or, testBit_and_ones]
  simp [show ¬ i < 3 ^ (r - 1) by omega]

/-- `dpP1` with the conversion network applied chunk-wise (the output of `fold3`, of
`3 ^ (r-1)` bits, is cut into chunks by balanced halving). -/
noncomputable def dpP1C (r s : Nat) (cnv : NetC) (cp : Cprog) : List Nat :=
  splitGC r s (applyNetC s cnv
    (toChunksAux s (3 ^ (r - 1) / 2 ^ s + 1) (3 ^ (r - 1) / 2 ^ s + 1) (fold3 r (dpB3 cp)) []))

theorem dpP1_eq_dpP1C {r s : Nat} {cnv : NetC} (h : netCOK s cnv = true) (cp : Cprog) :
    dpP1 r (netOfChunks s cnv) cp = dpP1C r s cnv cp := by
  have hW : 0 < 2 ^ s := Nat.two_pow_pos s
  rw [dpP1C, splitGC_eq, ofChunks_applyNetC h,
    ofChunks_toChunksAux s (3 ^ (r - 1) / 2 ^ s + 1) (3 ^ (r - 1) / 2 ^ s + 1) _ []
      (Nat.le_add_left 1 _) (Nat.le_succ _), ofChunks_nil, Nat.zero_shiftLeft, Nat.or_zero,
    and_ones_of_lt]
  · rfl
  · refine Nat.lt_of_lt_of_le (fold3_lt r _) (Nat.pow_le_pow_right (by norm_num) ?_)
    have := Nat.lt_div_mul_add (a := 3 ^ (r - 1)) hW
    rw [Nat.add_mul, Nat.one_mul]; omega

/-- `checkInit` with the conversion network applied chunk-wise. -/
noncomputable def checkInitC (r s : Nat) (cnv : NetC) (cp : Cprog) (H0 : List Nat) : Bool :=
  dpP1C r s cnv cp == expand r H0

/-- `checkFinal` with the conversion network applied chunk-wise. -/
noncomputable def checkFinalC (r s : Nat) (cnv : NetC) (cpc : Cprog) (H : List Nat) : Bool :=
  covered (dpP1C r s cnv cpc) (expand r H)

/-- **The chunked initial check is the initial check.** -/
theorem checkInit_eq_checkInitC {s : Nat} {cnv : NetC} (h : netCOK s cnv = true) (r : Nat)
    (cp : Cprog) (H0 : List Nat) :
    checkInit r (netOfChunks s cnv) cp H0 = checkInitC r s cnv cp H0 := by
  rw [checkInit, checkInitC, dpP1_eq_dpP1C h]

/-- **The chunked final check is the final check.** -/
theorem checkFinal_eq_checkFinalC {s : Nat} {cnv : NetC} (h : netCOK s cnv = true) (r : Nat)
    (cpc : Cprog) (H : List Nat) :
    checkFinal r (netOfChunks s cnv) cpc H = checkFinalC r s cnv cpc H := by
  rw [checkFinal, checkFinalC, dpP1_eq_dpP1C h]

end FourColor.Engine
